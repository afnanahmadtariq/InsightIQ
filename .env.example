# Used by Docker Compose locally and in production.
POSTGRES_DB=insightiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-production

# Used by Prisma commands run directly from your machine.
# Keep the credentials in sync with the PostgreSQL values above.
DATABASE_URL="postgresql://postgres:change-me-before-production@localhost:5432/insightiq?schema=public"

# Public domains used by Nginx and API CORS.
PRIMARY_DOMAIN=insightiq.zerotools.online
API_DOMAIN=api-insightiq.zerotools.online

# Authentication. Generate production secrets with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://api-insightiq.zerotools.online
BETTER_AUTH_TRUSTED_ORIGINS=https://insightiq.zerotools.online
BETTER_AUTH_COOKIE_DOMAIN=.zerotools.online

# Optional Google sign-in (configure both or neither).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional authentication email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="InsightIQ <auth@insightiq.zerotools.online>"

# Web source discovery through Tavily.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=6

# Worker LLM refinement through DashScope/Qwen.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max

# Worker poll loop (Docker Compose worker service).
WORKER_LOG_LEVEL=INFO
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=60
WORKER_LOCK_INTERVAL="10 minutes"
WORKER_BACKOFF_INTERVAL="30 seconds"
WORKER_USE_CRAWL4AI=false

# Playwright e2e (local/CI only — never enable in production).
E2E_ENABLED=false
E2E_SEED_SECRET=e2e-local-secret-ok
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_API_URL=http://127.0.0.1:3001
