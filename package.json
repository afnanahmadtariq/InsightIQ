{
  "name": "insightiq",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "npm run db:generate --workspace=@insightiq/db",
    "db:migrate": "npm run db:migrate --workspace=@insightiq/db",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@insightiq/db"
  },
  "dependencies": {
    "turbo": "^2.10.11"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "workerd@1.20260820.1": true
  }
}
