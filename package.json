{
  "name": "insightiq",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf .turbo",
    "db:generate": "npm run db:generate --workspace=@insightiq/db",
    "db:migrate": "npm run db:migrate --workspace=@insightiq/db",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@insightiq/db"
  },
  "dependencies": {
    "turbo": "^2.10.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/eslintrc": "^3.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
